# Copy to .env and fill in. Never commit .env.

# anthropic | ollama | fake
LLM_PROVIDER=fake

# Used when LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Used when LLM_PROVIDER=ollama (pick a vision model such as llava for image inputs)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# true = replay cached responses only, never call the network (safe live demo)
DEMO_MODE=false

LLM_TIMEOUT_S=60
